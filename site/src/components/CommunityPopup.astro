---
import html from '../partials/chrome/community-popup.html?raw';
import { communityLinksHtml } from '../lib/community.mjs';
// The cards come from src/data/community.json (label, href, icon, section, order); the partial is only the dialog shell.
const popup = html.replace('<!--oet:community-links-->', () => communityLinksHtml());
---
<Fragment set:html={popup} />
