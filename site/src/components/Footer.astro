---
import part1 from '../partials/chrome/footer-1.html?raw';
import part2 from '../partials/chrome/footer-2.html?raw';
import { addRecallsLink } from '../lib/recalls.mjs';
import { addArabicLibraryLink } from '../lib/blog.mjs';
const { showApps = false, lang = 'en', recalls = true } = Astro.props;
// "OET Recalls" / "ريكولز OET" in the Resources & Guides group, directly after "OET Blog", then "مقالات OET بالعربي" (the Arabic
// library, brief of 22 Nov 2026). Neither is rendered on the two frozen landing pages.
const links = recalls ? addArabicLibraryLink(addRecallsLink(part2, lang === 'ar' ? 'ar' : 'en', 'footer'), 'footer') : part2;
---
<Fragment set:html={part1} /><li><a href="/pricing.html#download-app">Download Candidates App</a></li><Fragment set:html={links} />
