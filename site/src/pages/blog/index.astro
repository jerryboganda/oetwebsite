---
// OET Blog index (/blog/). Built from src/data/blog.json via src/lib/blog.mjs;
// every card is plain HTML (crawlable), the search box only filters what is there.
import Base from '../../layouts/Base.astro';
import headExtra from '../../partials/oet-writing-tips/head-extra.html?raw';
import tail from '../../partials/oet-writing-tips/tail.html?raw';
import { loadBlog, latestPosts, renderCard, escapeHtml } from '../../lib/blog.mjs';

const SITE = 'https://oetwithdrhesham.co.uk';
const { categories, posts } = loadBlog();
const latest = latestPosts(posts);
const description =
  'Practical OET advice for Listening, Reading, Writing and Speaking, plus exam format and pathway guides for doctors, nurses and allied health professionals.';

const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    '@id': `${SITE}/blog/#blog`,
    name: 'OET Blog: Tips, Practice & Exam Guides',
    url: `${SITE}/blog/`,
    description,
    inLanguage: 'en-GB',
    publisher: { '@type': 'Organization', '@id': `${SITE}/#organization`, name: 'OET with Dr Hesham', url: `${SITE}/` },
    blogPost: posts.map((p) => ({
      '@type': 'BlogPosting',
      headline: p.title,
      url: `${SITE}${p.url}`,
      datePublished: p.datePublished,
      dateModified: p.dateModified,
      image: `${SITE}${p.image}`,
      articleSection: p.categoryLabel,
      author: { '@type': 'Person', '@id': `${SITE}/#drhesham`, name: 'Dr Ahmed Hesham', url: `${SITE}/about.html` },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
      { '@type': 'ListItem', position: 2, name: 'OET Blog', item: `${SITE}/blog/` },
    ],
  },
];

const meta = `<title>OET Blog: Tips, Practice &amp; Exam Guides | Dr Hesham</title>
    <meta name="description" content="${escapeHtml(description)}">
    <link rel="canonical" href="${SITE}/blog/">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="OET with Dr Hesham">
    <meta property="og:locale" content="en_GB">
    <meta property="og:url" content="${SITE}/blog/">
    <meta property="og:title" content="OET Blog: Tips, Practice &amp; Exam Guides">
    <meta property="og:description" content="${escapeHtml(description)}">
    <meta property="og:image" content="${SITE}/assets/img/og/og-tips.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <script type="application/ld+json">
${JSON.stringify(ld, null, 2)}
    </script>`;

const chips = [
  `<li><a class="oet-blog-chip" href="#all-articles">All Articles <span>${posts.length}</span></a></li>`,
  ...categories.map((c) => {
    const n = posts.filter((p) => p.category === c.id).length;
    return `<li><a class="oet-blog-chip" href="#${c.id}">${escapeHtml(c.label)} <span>${n}</span></a></li>`;
  }),
].join('');

const sections = categories
  .map((c) => {
    const list = posts.filter((p) => p.category === c.id);
    return `<section class="oet-blog-section" id="${c.id}" aria-labelledby="${c.id}-title">
      <div class="oet-blog-section__head"><h2 id="${c.id}-title">${escapeHtml(c.label)}</h2><p>${escapeHtml(c.intro)}</p></div>
      <div class="oet-blog-grid">
${list.map((p) => renderCard(p)).join('\n')}
      </div>
    </section>`;
  })
  .join('\n');

const main = `    <main id="main-content" class="oet-blog" tabindex="-1">
        <section class="oet-resource-hero oet-skill-hero oet-blog-hero">
            <div class="container">
                <nav class="oet-breadcrumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li aria-current="page">OET Blog</li></ol></nav>
                <div class="oet-blog-hero__grid">
                    <div>
                        <span class="oet-resource-eyebrow"><i class="fa-solid fa-book-open-reader" aria-hidden="true"></i> Articles by Dr Ahmed Hesham</span>
                        <h1 class="oet-resource-title">OET Blog: Tips, Practice &amp; Exam Guides</h1>
                        <p class="oet-resource-lead">Practical advice for Listening, Reading, Writing, Speaking and OET preparation on computer or paper.</p>
                    </div>
                    <form class="oet-blog-search" role="search" action="/blog/" onsubmit="return false;">
                        <label for="oet-blog-search-input">Search articles</label>
                        <div class="oet-blog-search__field">
                            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                            <input id="oet-blog-search-input" type="search" name="q" placeholder="e.g. referral letter, Part A" autocomplete="off" aria-describedby="oet-blog-search-status">
                        </div>
                        <p id="oet-blog-search-status" class="oet-blog-search__status" aria-live="polite">${posts.length} articles</p>
                    </form>
                </div>
                <nav class="oet-blog-chips" aria-label="Article categories"><ul>${chips}</ul></nav>
            </div>
        </section>

        <div class="container oet-blog-body">
            <section class="oet-blog-section oet-blog-latest" id="all-articles" aria-labelledby="latest-title">
                <div class="oet-blog-section__head"><h2 id="latest-title">Latest articles</h2><p>New guides and the most useful places to start.</p></div>
                <div class="oet-blog-grid">
${latest.map((p) => renderCard(p, { eager: true })).join('\n')}
                </div>
            </section>
${sections}
            <p class="oet-blog-empty" hidden>No articles match your search. Try a skill such as Writing or a part such as Part A.</p>
            <section class="oet-blog-next" aria-label="Practise what you read">
                <h2>Put the advice into practice</h2>
                <p>Free sample tests, model letters and role-plays, plus timed practice and mock exams in the learner app.</p>
                <div class="oet-resource-actions"><a class="oet-resource-btn" href="/oet-practice.html#free-practice">Start Free Practice <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a><a class="oet-resource-btn oet-resource-btn--light" href="/service.html">Explore OET Courses</a></div>
            </section>
        </div>
    </main>
    <script>
    (function () {
        var input = document.getElementById('oet-blog-search-input');
        var status = document.getElementById('oet-blog-search-status');
        var root = document.querySelector('.oet-blog');
        if (!input || !root) return;
        var latest = root.querySelector('.oet-blog-latest');
        var empty = root.querySelector('.oet-blog-empty');
        var total = root.querySelectorAll('.oet-blog-section:not(.oet-blog-latest) .oet-blog-card').length;
        function run() {
            var terms = input.value.toLowerCase().trim().split(/\\s+/).filter(Boolean);
            var shown = 0;
            root.querySelectorAll('.oet-blog-section:not(.oet-blog-latest)').forEach(function (section) {
                var visible = 0;
                section.querySelectorAll('.oet-blog-card').forEach(function (card) {
                    var hay = card.getAttribute('data-search') || '';
                    var match = terms.every(function (t) { return hay.indexOf(t) !== -1; });
                    card.hidden = !match;
                    if (match) visible++;
                });
                section.hidden = visible === 0;
                shown += visible;
            });
            if (latest) latest.hidden = terms.length > 0;
            if (empty) empty.hidden = shown !== 0;
            status.textContent = terms.length ? shown + (shown === 1 ? ' article matches' : ' articles match') : total + ' articles';
        }
        input.addEventListener('input', run);
    })();
    </script>`;
---
<Base
  meta={meta}
  headExtra={headExtra}
  main={main}
  tail={tail}
  bodyClass="oet-live-site oet-resource-page"
  salCss={true}
/>
