---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CommunityPopup from '../components/CommunityPopup.astro';
import { enrichPage } from '../lib/page.mjs';

interface Props {
  meta: string;
  headExtra: string;
  main: string;
  tail: string;
  bodyClass?: string;
  swiperCss?: boolean;
  salCss?: boolean;
  styleCss?: boolean;
  heroCss?: boolean;
  showApps?: boolean;
  lang?: string;
}

const {
  bodyClass = 'oet-live-site',
  swiperCss = false,
  salCss = false,
  styleCss = true,
  heroCss = false,
  showApps = false,
  lang = 'en',
} = Astro.props;

// Site-wide build markers, entity nodes, dates byline, author box, related articles and derived head tags
// (src/lib/page.mjs). Runs after the page wrapper's own injections (pricing, bundles, promo, story counts).
const { meta, headExtra, main, tail } = enrichPage({
  meta: Astro.props.meta,
  headExtra: Astro.props.headExtra,
  main: Astro.props.main,
  tail: Astro.props.tail,
});
---
<html lang={lang} class="oet-live-site">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <script is:inline>
      (function () {
        try {
          var m = window.matchMedia;
          if (m && (
            m('(max-width:1023.98px)').matches ||
            m('(pointer:coarse)').matches ||
            m('(hover:none)').matches ||
            m('(prefers-reduced-motion:reduce)').matches
          )) {
            document.documentElement.classList.add('oet-lite-motion');
          }
        } catch (e) {}
      })();
    </script>
    <script is:inline>
      // Signed-in hint set by the learner app (shared-domain cookie oet_signed_in=1, no token or PII).
      // Presentation only. The header and drawer CTA always READS "Login / Register" (owner brief
      // 28 Oct 2026); the hint only decides where it points: the app dashboard when the cookie exists
      // (so a signed-in visitor is not sent back through sign-in), the sign-in entry otherwise.
      // sync() is idempotent and runs: now, on DOMContentLoaded (the nav anchors exist and the deferred
      // main.js has already cloned the nav into the mobile drawer; a clone copies whatever href it
      // finds, and this pass fixes it), and on a bfcache restore (pageshow persisted) so Back after
      // sign-in or sign-out never leaves a stale target. The guest href is remembered in
      // data-login-href the first time an anchor is seen.
      (function () {
        var d = document;
        function sync() {
          try {
            var on = /(?:^|;\s*)oet_signed_in=1(?:;|$)/.test(d.cookie);
            d.querySelectorAll('a[data-dashboard-href]').forEach(function (a) {
              if (!a.hasAttribute('data-login-href')) a.setAttribute('data-login-href', a.getAttribute('href'));
              a.setAttribute('href', a.getAttribute(on ? 'data-dashboard-href' : 'data-login-href'));
            });
          } catch (e) {}
        }
        sync();
        d.addEventListener('DOMContentLoaded', sync);
        window.addEventListener('pageshow', function (e) { if (e.persisted) sync(); });
      })();
    </script>
    <Fragment set:html={meta} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="facebook-domain-verification" content="4j7vanqeax6mvmydb4sod34bj388dv" />
    <link rel="icon" href="/favicon.ico?v=20261109" sizes="32x32" />
    <link rel="icon" href="/assets/img/logo/fav-icon.svg?v=20261109" type="image/svg+xml" />
    <link rel="icon" href="/assets/img/logo/favicon-32x32.png?v=20261109" type="image/png" sizes="32x32" />
    <link rel="icon" href="/assets/img/logo/favicon-16x16.png?v=20261109" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=20261109" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest?v=20261109" />
    {styleCss && <link rel="preload" href="/assets/fonts/mulish-latin-var.woff2" as="font" type="font/woff2" crossorigin />}
    {styleCss && <link rel="preload" href="/assets/fonts/cal-sans-latin.woff2" as="font" type="font/woff2" crossorigin />}
    <link rel="stylesheet" href="/assets/css/plugins/bootstrap.purged.min.css" />
    {swiperCss && <link rel="stylesheet" href="/assets/css/plugins/swiper-bundle.min.css" />}
    <link rel="stylesheet" href="/assets/css/oet-icons.css" />
    {salCss && <link rel="stylesheet" href="/assets/css/plugins/sal.css" />}
    {styleCss && <link rel="stylesheet" href="/assets/css/style.min.css" />}
    <link rel="stylesheet" href="/assets/css/oet-common.css" />
    <link rel="stylesheet" href="/assets/css/oet-mobile.css" />
    <link rel="stylesheet" href="/assets/css/oet-cookie-consent.css" />
    <link rel="stylesheet" href="/assets/css/oet-polish.css" />
    <link rel="stylesheet" href="/assets/css/oet-redesign.css" />
    {heroCss && <link rel="stylesheet" href="/assets/css/oet-hero.css" />}
    <Fragment set:html={headExtra} />
</head>
<body class={bodyClass || undefined}>
    <a class="oet-skip-link" data-lenis-ignore-anchor href="#main-content">Skip to main content</a>
<!--================= Header section start =================-->
    <Header showApps={showApps} />
<!--================= Header section End =================-->
<Fragment set:html={main} />
<!--================= Footer section start =================-->
    <Footer showApps={showApps} />
<!--================= Footer section End =================-->
<Fragment set:html={tail} />
    <CommunityPopup />
    <script src="/assets/js/oet-analytics.js" defer is:inline></script>
    <script src="/assets/js/oet-cookie-consent.js" defer is:inline></script>
    <script src="/assets/js/oet-search.js" defer is:inline></script>
</body>
</html>
