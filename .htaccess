# OET with Dr Hesham — Apache/LiteSpeed configuration
# Phase 0: 301 redirects for removed template pages + 404 handling
# Phase 1: compression + browser caching (Hostinger LiteSpeed compatible)

ErrorDocument 404 /404.html

# ---------------------------------------------------------------
# Compression (brotli where available, gzip fallback)
# ---------------------------------------------------------------
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml
    AddOutputFilterByType BROTLI_COMPRESS text/javascript application/javascript application/x-javascript
    AddOutputFilterByType BROTLI_COMPRESS application/json application/ld+json application/xml
    AddOutputFilterByType BROTLI_COMPRESS image/svg+xml font/ttf font/otf
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/ld+json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml font/ttf font/otf
    # already-compressed formats
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|avif|woff2?|mp4|zip)$ no-gzip
</IfModule>

# ---------------------------------------------------------------
# Browser caching
# ---------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 week"

    # HTML: always revalidate (content changes without filename change)
    ExpiresByType text/html "access plus 0 seconds"

    # Static assets
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType application/json "access plus 1 hour"
    ExpiresByType application/xml "access plus 1 day"
    ExpiresByType text/xml "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
    # HTML + JSON data: short-lived, must revalidate
    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.json$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>

    # Versioned static assets: cache hard (cache-busting via ?v= query)
    <FilesMatch "\.(css|js|avif|webp|png|jpe?g|gif|svg|ico|woff2?|ttf|mp4)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# Correct MIME types for modern formats
<IfModule mod_mime.c>
    AddType image/avif .avif
    AddType image/webp .webp
    AddType font/woff2 .woff2
    AddCharset utf-8 .html .css .js .json .xml .svg
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On

# --- Removed template demo pages -> relevant live pages (301) ---

# Consulting demo variants -> home
RewriteRule ^(Accountant|Accountant-Single|BusinessConsulting|BusinessConsulting-Single|BusinessConsulting2|BusinessConsulting2-Single|CorporateConsulting|CorporateConsulting-Single|FinanceConsulting|FinanceConsulting-Single|FinancialAdvisor|FinancialAdvisor-Single|HrConsulting|HrConsulting-Single|InsuranceConsulting|InsuranceConsulting-Single|MarketingConsulting|MarketingConsulting-Single|TaxConsulting|TaxConsulting-Single)\.html$ / [R=301,L]

# Blog templates -> OET tips hub
RewriteRule ^blog-(left|right|single|style-one|style-two|style-three)\.html$ /oet-tips.html [R=301,L]

# Portfolio + testimonial templates -> success stories
RewriteRule ^portfolio(-left|-right|-single)?\.html$ /success-stories.html [R=301,L]
RewriteRule ^testimonial\.html$ /success-stories.html [R=301,L]

# Team templates -> about
RewriteRule ^team(-details)?\.html$ /about.html [R=301,L]

# Service layout templates -> courses
RewriteRule ^service-(left|right|single)\.html$ /service.html [R=301,L]

# Template preview page -> home
RewriteRule ^preview\.html$ / [R=301,L]
</IfModule>

# Deny access to internal docs
<IfModule mod_alias.c>
RedirectMatch 404 ^/docs/
</IfModule>
