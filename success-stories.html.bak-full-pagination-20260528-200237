            color: #fff;
            background: #6044f5;
            border-color: #6044f5;
        }

        .success-tab.is-active span {
            color: #6044f5;
            background: #fff;
        }

        .success-tab:disabled {
            opacity: .45;
            cursor: not-allowed;
        }

        .success-gallery-heading {
            display: flex;
            align-items: end;
            justify-content: space-between;
            gap: 24px;
            margin-bottom: 28px;
        }

