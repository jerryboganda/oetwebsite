        .success-stat strong {
            display: block;
            color: #6044f5;
            font-size: 34px;
            line-height: 1;
            margin-bottom: 7px;
        }

        .success-stat span {
            color: #5f6075;
            font-weight: 600;
        }

        .success-actions {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            margin-top: 30px;
        }

        .success-btn {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            min-height: 52px;
            padding: 0 22px;
            border-radius: 8px;
            font-weight: 800;
            color: #fff;
            background: #6044f5;
            box-shadow: 0 16px 34px rgba(96, 68, 245, 0.24);
        }

        .success-btn--ghost {
            color: #211d45;
            background: #fff;
            box-shadow: 0 14px 30px rgba(73, 57, 185, 0.10);
        }

        .success-gallery-section {
            position: relative;
            padding: 50px 0 92px;
            background: #f7f4ff;
        }

        .success-tabs-wrap {
            position: sticky;
            top: 0;
            z-index: 20;
            margin-bottom: 34px;
            padding: 12px 0;
            background: rgba(247, 244, 255, 0.84);
            backdrop-filter: blur(14px);
        }

        .success-tabs {
            display: flex;
            gap: 10px;
            overflow-x: auto;
            scrollbar-width: none;
        }

        .success-tabs::-webkit-scrollbar { display: none; }

        .success-tab {
            flex: 0 0 auto;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            min-height: 44px;
            padding: 0 16px;
            border: 1px solid rgba(96, 68, 245, 0.14);
            border-radius: 999px;
            color: #2d2d43;
            background: #fff;
            font-weight: 800;
            transition: transform .18s ease, background .18s ease, color .18s ease;
        }

        .success-tab span {
            min-width: 26px;
