        }

        .vl-main-menu ul > li .sub-menu li a .submenu-icon,
        .vl-offcanvas-menu ul li .sub-menu li a .submenu-icon {
            width: 20px;
            flex: 0 0 20px;
            display: inline-flex;
            justify-content: center;
            align-items: center;
            font-size: 16px;
            color: var(--vkl-text-primary-color-1);
            transition: color 0.25s ease;
        }

        .vl-main-menu ul > li .sub-menu li a .submenu-text,
        .vl-offcanvas-menu ul li .sub-menu li a .submenu-text {
            display: inline-block;
            white-space: nowrap;
            font-size: 17px;
            line-height: 1.25;
        }

        .vl-main-menu ul > li .sub-menu li a:hover,
        .vl-main-menu ul > li .sub-menu li a:focus-visible,
        .vl-offcanvas-menu ul li .sub-menu li a:hover,
        .vl-offcanvas-menu ul li .sub-menu li a:focus-visible {
            background: linear-gradient(135deg, #5f46f5 0%, #7c67ff 100%);
            color: #ffffff;
            transform: translateX(6px);
            box-shadow: 0 12px 24px rgba(95, 70, 245, 0.22);
        }

        .vl-main-menu ul > li .sub-menu li a:hover .submenu-icon,
        .vl-main-menu ul > li .sub-menu li a:focus-visible .submenu-icon,
        .vl-offcanvas-menu ul li .sub-menu li a:hover .submenu-icon,
        .vl-offcanvas-menu ul li .sub-menu li a:focus-visible .submenu-icon {
            color: #ffffff;
        }

        .vl-main-menu ul > li .sub-menu li .sub-menu,
        .vl-offcanvas-menu ul li .sub-menu li .sub-menu {
            left: calc(100% + 10px);
            top: 0;
            min-width: 240px;
        }

        .vl-main-menu ul > li .sub-menu li.has-dropdown {
            position: relative;
        }

        .vl-main-menu ul > li .sub-menu li.has-dropdown > .sub-menu {
            display: block;
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transform: translateX(8px) scale(0.98);
            transition: opacity 0.2s ease, visibility 0.2s ease, transform 0.2s ease;
            z-index: 20;
        }

        .vl-main-menu ul > li .sub-menu li.has-dropdown:hover > .sub-menu,
        .vl-main-menu ul > li .sub-menu li.has-dropdown:focus-within > .sub-menu {
            display: block;
            opacity: 1 !important;
            visibility: visible !important;
            transform: translateX(0) scale(1) !important;
            pointer-events: auto;
        }

        .vl-main-menu ul > li .sub-menu li a .downarrow,
        .vl-offcanvas-menu ul li .sub-menu li a .downarrow {
            right: 14px;
        }

