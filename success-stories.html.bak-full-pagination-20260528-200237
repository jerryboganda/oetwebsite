;: &quot;https://drive.google.com/file/d/1SlcZZLeJJ2wakDru9GpdSYjomtBpYbAH/view&quot;, &quot;alt&quot;: &quot;OET success story screenshot from 2023&quot;, &quot;width&quot;: 1080, &quot;height&quot;: 2155}, {&quot;id&quot;: &quot;1N6JCCQygOYCS5rIY5oww6atpHFP9o5ST&quot;, &quot;filename&quot;: &quot;IMG_20231114_110431.jpg&quot;, &quot;year&quot;: &quot;2023&quot;, &quot;platform&quot;: &quot;Other&quot;, &quot;optimizedSrc&quot;: &quot;assets/img/success-stories/optimized/2023-050-IMG_20231114_110431.webp&quot;, &quot;originalSrc&quot;: &quot;assets/img/success-stories/originals/2023-050-IMG_20231114_110431.jpg&quot;, &quot;originalDriveUrl&quot;: &quot;https://drive.google.com/file/d/1N6JCCQygOYCS5rIY5oww6atpHFP9o5ST/view&quot;, &quot;alt&quot;: &quot;OET success story screenshot from 2023&quot;, &quot;width&quot;: 1080, &quot;height&quot;: 2155}]</script>
<script>
(function () {
    const dataEl = document.getElementById('success-stories-data');
    if (!dataEl) return;
    const stories = JSON.parse(dataEl.textContent);
    const tabs = Array.from(document.querySelectorAll('.success-tab'));
    const cards = Array.from(document.querySelectorAll('.success-card'));
    const empty = document.getElementById('success-empty');
    const lightbox = document.getElementById('success-lightbox');
    const img = document.getElementById('success-lightbox-img');
    const yearLabel = document.getElementById('success-lightbox-year');
    const platformLabel = document.getElementById('success-lightbox-platform');
    const originalLink = document.getElementById('success-lightbox-original');
    let visibleIndexes = cards.map(card => Number(card.dataset.index));
    let current = 0;

    function applyFilter(year) {
        tabs.forEach(tab => tab.classList.toggle('is-active', tab.dataset.year === year));
        visibleIndexes = [];
        cards.forEach(card => {
            const match = year === 'All' || card.dataset.year === year;
            card.hidden = !match;
            if (match) visibleIndexes.push(Number(card.dataset.index));
        });
        empty.classList.toggle('is-visible', visibleIndexes.length === 0);
    }

    function openAt(storyIndex) {
        const story = stories[storyIndex];
        if (!story) return;
        current = visibleIndexes.indexOf(storyIndex);
        if (current < 0) current = 0;
        img.src = story.optimizedSrc;
        img.alt = story.alt || story.filename;
        yearLabel.textContent = story.year;
        platformLabel.textContent = story.platform;
        originalLink.href = story.originalDriveUrl;
        lightbox.classList.add('is-open');
        lightbox.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
    }

    function close() {
        lightbox.classList.remove('is-open');
        lightbox.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
    }

    function step(delta) {
        if (!visibleIndexes.length) return;
        current = (current + delta + visibleIndexes.length) % visibleIndexes.length;
        openAt(visibleIndexes[current]);
    }

    tabs.forEach(tab => tab.addEventListener('click', () => { if (!tab.disabled) applyFilter(tab.dataset.year); }));
    cards.forEach(card => card.querySelector('button').addEventListener('click', () => openAt(Number(card.dataset.index))));
    document.getElementById('success-close').addEventListener('click', close);
    document.getElementById('success-prev').addEventListener('click', () => step(-1));
    document.getElementById('success-next').addEventListener('click', () => step(1));
    lightbox.addEventListener('click', event => { if (event.target === lightbox) close(); });
    document.addEventListener('keydown', event => {
        if (!lightbox.classList.contains('is-open')) return;
        if (event.key === 'Escape') close();
        if (event.key === 'ArrowLeft') step(-1);
        if (event.key === 'ArrowRight') step(1);
    });
    applyFilter('All');
})();
</script>
