        .brand-badge {
            width: 100%;
            height: 100%;
            box-sizing: border-box;
            padding: 12px 18px 11px;
            border-radius: 12px;
            background: linear-gradient(180deg, #ffffff 0%, #fcfbff 100%);
            border: 1px solid rgba(100, 74, 249, 0.1);
            box-shadow: 0 10px 24px rgba(100, 74, 249, 0.05);
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
            align-items: flex-start;
            gap: 3px;
            text-align: left;
            transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease, background 0.25s ease;
        }

        .brand-badge:hover {
            transform: translateY(-4px);
            background: linear-gradient(180deg, #ffffff 0%, #f7f4ff 100%);
            border-color: rgba(100, 74, 249, 0.18);
            box-shadow: 0 16px 34px rgba(100, 74, 249, 0.1);
        }

        .brand-badge__icon {
            width: 68px;
            height: 68px;
            border-radius: 18px;
            background: rgba(100, 74, 249, 0.08);
            color: #644af9;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            flex: 0 0 68px;
            box-shadow: 0 8px 18px rgba(100, 74, 249, 0.07);
            transition: background 0.25s ease, color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
        }

        .brand-badge:hover .brand-badge__icon {
            background: #644af9;
            color: #ffffff;
            box-shadow: 0 10px 22px rgba(100, 74, 249, 0.18);
            transform: translateY(-1px) scale(1.03);
        }

