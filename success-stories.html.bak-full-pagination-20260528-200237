        .success-hero {
            position: relative;
            padding: 176px 0 58px;
            background:
                radial-gradient(circle at 78% 24%, rgba(105, 77, 255, 0.22), transparent 34%),
                linear-gradient(135deg, #eee9ff 0%, #f8f5ff 48%, #e9e2ff 100%);
        }

        .success-hero::after {
            content: "";
            position: absolute;
            inset: auto -10% -1px -10%;
            height: 90px;
            background: linear-gradient(180deg, rgba(247,244,255,0), #f7f4ff 76%);
            pointer-events: none;
        }

        .success-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            margin-bottom: 18px;
            padding: 9px 14px;
            border-radius: 999px;
            color: #5f43f3;
            background: #ffffff;
            box-shadow: 0 12px 34px rgba(84, 61, 220, 0.12);
            font-weight: 700;
        }

        .success-title {
            max-width: 840px;
            margin: 0;
            font-size: clamp(48px, 7vw, 112px);
            line-height: 0.92;
            letter-spacing: 0;
            color: #101327;
        }

        .success-lede {
            max-width: 720px;
            margin: 28px 0 0;
            color: #5f6075;
            font-size: 20px;
            line-height: 1.65;
        }

        .success-stat-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 14px;
            margin-top: 18px;
        }

        .success-stat {
            padding: 20px;
            border: 1px solid rgba(96, 68, 245, 0.12);
