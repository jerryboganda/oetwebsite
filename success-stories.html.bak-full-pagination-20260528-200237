        .vl-offcanvas-menu ul li .sub-menu li a {
            color: var(--vkl-text-heading-color-1);
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 17px;
            line-height: 1.25;
            white-space: nowrap;
            width: calc(100% - 24px);
