
:root{--oet-ink:#16213e;--oet-muted:#667085;--oet-lav:#eeeaff;--oet-purple:#5f46f5;--oet-line:#ded8fb}
.oet-legal-body{margin:0;background:linear-gradient(180deg,#f7f5ff 0,#fff 32%);color:var(--oet-ink);font-family:Arial,sans-serif}.oet-legal-header{background:#fff;border-bottom:1px solid var(--oet-line);position:sticky;top:0;z-index:20}.oet-legal-nav{max-width:1180px;margin:auto;padding:15px 22px;display:flex;align-items:center;justify-content:space-between;gap:18px}.oet-legal-nav img{width:145px;height:auto}.oet-legal-nav a{color:var(--oet-ink);text-decoration:none;font-weight:700}.oet-legal-links{display:flex;gap:18px;flex-wrap:wrap}.oet-legal-hero{background:var(--oet-lav);padding:62px 22px 86px;position:relative;overflow:hidden}.oet-legal-hero:after{content:"";position:absolute;width:340px;height:340px;border-radius:50%;right:-80px;top:-150px;background:rgba(95,70,245,.12)}.oet-legal-hero-inner{max-width:980px;margin:auto;position:relative;z-index:1}.oet-legal-kicker{color:var(--oet-purple);font-size:12px;font-weight:800;letter-spacing:.18em;text-transform:uppercase}.oet-legal-hero h1{font-size:clamp(36px,6vw,62px);line-height:1.05;margin:12px 0 10px;font-family:Georgia,serif}.oet-legal-hero p{max-width:680px;color:#4f5570}.oet-legal-main{max-width:980px;margin:-48px auto 64px;padding:0 20px;position:relative;z-index:2}.oet-legal-main .card{background:#fff;border:1px solid var(--oet-line);border-radius:24px;padding:clamp(22px,5vw,54px);box-shadow:0 24px 70px rgba(35,29,80,.12)}.oet-legal-main h1{display:none}.oet-legal-main h2{font-family:Georgia,serif;color:var(--oet-ink);font-size:25px;margin-top:34px}.oet-legal-main p,.oet-legal-main li,.oet-legal-main td,.oet-legal-main th{line-height:1.75;color:#4f5570}.oet-legal-main a{color:var(--oet-purple)}.oet-legal-main table{width:100%;border-collapse:collapse;display:block;overflow-x:auto}.oet-legal-main td,.oet-legal-main th{border:1px solid var(--oet-line);padding:10px;text-align:left}.oet-legal-footer{background:#15152a;color:#fff;padding:34px 22px}.oet-legal-footer-inner{max-width:980px;margin:auto}.oet-legal-footer a{color:#ddd8ff;text-decoration:none;margin-right:16px;line-height:2.1}.oet-legal-footer button{border:0;background:none;color:#ddd8ff;padding:0;cursor:pointer;font:inherit}.oet-cc{position:fixed;inset:auto 16px 16px;max-width:760px;margin:auto;background:#fff;border:1px solid #ded8fb;border-radius:20px;padding:20px;box-shadow:0 20px 55px rgba(22,33,62,.24);z-index:9999;color:#16213e}.oet-cc[hidden]{display:none}.oet-cc h2{font:700 22px Georgia,serif;margin:0 0 8px}.oet-cc p{color:#667085;line-height:1.55}.oet-cc-actions{display:flex;flex-wrap:wrap;gap:8px}.oet-cc button{border:1px solid #ded8fb;border-radius:9px;padding:9px 13px;font-weight:700;background:#fff;color:#16213e;cursor:pointer}.oet-cc .primary{background:#5f46f5;color:#fff;border-color:#5f46f5}.oet-cc-prefs{display:grid;gap:8px;margin:12px 0}.oet-cc-prefs label{border:1px solid #ded8fb;border-radius:9px;padding:10px}@media(max-width:680px){.oet-legal-links{display:none}.oet-legal-hero{padding-top:44px}.oet-legal-main{margin-top:-34px}.oet-legal-nav img{width:118px}}

/* Consent visual alignment with production community popup */
.oet-cc{max-width:790px;border:1px solid rgba(101,76,245,.23)!important;border-radius:24px!important;padding:25px 26px!important;background:linear-gradient(145deg,#fff 0%,#fbf9ff 100%)!important;box-shadow:0 24px 70px rgba(45,33,105,.22)!important;color:#070b34!important}
.oet-cc:before{content:"Privacy preferences";display:inline-flex;margin-bottom:10px;color:#654cf5;font-size:12px;font-weight:800;letter-spacing:.15em;text-transform:uppercase}
.oet-cc h2{font-family:inherit!important;color:#070b34!important;font-size:25px!important;font-weight:800!important}.oet-cc p{color:#555878!important}.oet-cc a{color:#654cf5;font-weight:700}
.oet-cc-prefs label{border:1px solid rgba(101,76,245,.15)!important;border-radius:13px!important;background:#fff;padding:12px!important;color:#302b59}
.oet-cc button{border-radius:999px!important;padding:10px 16px!important;border-color:rgba(101,76,245,.2)!important;transition:transform .2s ease,box-shadow .2s ease!important}.oet-cc button:hover{transform:translateY(-1px);box-shadow:0 9px 18px rgba(83,57,214,.1)}.oet-cc .primary{background:linear-gradient(135deg,#654cf5,#7b61ff)!important;border-color:#654cf5!important}.oet-cc button:focus-visible{outline:3px solid rgba(101,76,245,.35);outline-offset:3px}
@media(max-width:575px){.oet-cc{inset:auto 10px 10px!important;padding:19px 17px!important;border-radius:18px!important}.oet-cc-actions{gap:7px!important}.oet-cc button{padding:9px 12px!important;font-size:13px}}
@media(prefers-reduced-motion:reduce){.oet-cc button{transition:none!important}.oet-cc button:hover{transform:none}}
