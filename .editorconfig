# Root defaults for the whole repo.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,mjs,json,astro,yml,yaml,py}]
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.php]
indent_style = space
indent_size = 4

# Generated partials mirror the original hand-written pages byte-for-byte —
# never reformat them.
[site/src/partials/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
